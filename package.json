{
  "name": "construction-progress",
  "version": "1.0.0",
  "description": "Desktop app for construction progress planning and Gantt scheduling.",
  "productName": "Construction Progress",
  "author": "Construction Progress",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "node electron/launch.js",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "vn.construction.progress",
    "productName": "Construction Progress",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "tdtc",
        "name": "Construction Progress Project",
        "description": "Construction Progress Project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "executableName": "Construction Progress"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Construction Progress",
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  }
}
